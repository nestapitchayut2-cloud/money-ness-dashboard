}

// ── Gemini Image Brief style picker ──
// Convention (ดู style-guide.md → GEMINI IMAGE BRIEF FORMAT): เขียน prompt แต่ละสไตล์คั่นด้วย
// '### Style: <emoji label>' ตามด้วย prompt ของสไตล์นั้น จบสไตล์เมื่อเจอ '### Style:' ถัดไป, 'ข้อความภาษาไทย', หรือ '---'
function extractGeminiBriefStyles(markdown) {
  const re = /### Style: (.+?)\r?\n([\s\S]*?)(?=\r?\n### Style:|\r?\nข้อความภาษาไทย|\r?\n---|$)/g;
  const styles = [];
  let m;
  while ((m = re.exec(markdown)) !== null) {
    const text = m[2].trim();
    if (text) styles.push({ label: m[1].trim(), text: text });
  }
  return styles;
}

function injectGeminiStylePicker(bodyEl, styles) {
  const headings = bodyEl.querySelectorAll('h2, h3');
  let targetHeading = null;
  headings.forEach(h => { if (h.textContent.includes('Gemini Image Brief')) targetHeading = h; });
  if (!targetHeading) return;
  const bar = document.createElement('div');
  bar.style.cssText = 'margin:10px 0 16px;padding:10px 12px;background:#f1f5f9;border-radius:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:14px';
  const label = document.createElement('span');
  label.textContent = '🎨 เลือกสไตล์ภาพก่อน copy:';
  label.style.cssText = 'font-weight:600;color:#334155';
  const select = document.createElement('select');
  select.style.cssText = 'padding:6px 10px;border-radius:6px;border:1px solid #cbd5e1;font-size:14px';
  styles.forEach((s, i) => {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = s.label;
    select.appendChild(opt);
  });
  const btn = document.createElement('button');
  btn.textContent = '📋 Copy Prompt';
  btn.style.cssText = 'padding:6px 14px;border-radius:6px;border:none;background:#2563eb;color:#fff;cursor:pointer;font-weight:600;font-size:14px';
  btn.onclick = () => {
    const chosen = styles[select.value];
    navigator.clipboard.writeText(chosen.text).then(() =>
      (typeof showToast==='function') ? showToast('📋 คัดลอก Prompt สไตล์ "' + chosen.label + '" แล้ว') : alert('คัดลอกแล้ว')
    );
  };
  bar.appendChild(label);
  bar.appendChild(select);
  bar.appendChild(btn);
  targetHeading.insertAdjacentElement('afterend', bar);
}"""

content = content.replace(anchor, new_block, 1)

with io.open(path, 'w', encoding='utf-8') as f:
    f.write(content)

print("patched OK, new size", len(content))
