if broken_marker in content:
    start = content.index("\n// ── Gemini Image Brief style picker ──")
    end_marker = "  bar.appendChild(select);\n  bar.appendChild(btn);\n  targetHeading.insertAdjacentElement('afterend', bar);\n}"
    end = content.index(end_marker) + len(end_marker)
    content = content[:start] + content[end:]
    # also remove the two lines calling the functions inside openBriefFile, restore original
    called = "    bodyEl.innerHTML = marked.parse(content);\n    const geminiStyles = extractGeminiBriefStyles(content);\n    if (geminiStyles.length) injectGeminiStylePicker(bodyEl, geminiStyles);\n  } catch(e) {"
    original_call = "    bodyEl.innerHTML = marked.parse(content);\n  } catch(e) {"
    if called in content:
        content = content.replace(called, original_call, 1)

